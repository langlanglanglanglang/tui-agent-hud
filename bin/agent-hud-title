#!/usr/bin/env bash
# agent-hud-title — 底栏详情。输出当前 active window 的纯任务标题。
#
# window_name 仅用于定位标题缓存；红绿灯和任务编号留在窗口标签中，
# 不重复拼进右侧详情。
# 标题三级回退：
#   1) 标题缓存 $XDG_CACHE_HOME/tui-agent-hud/title/<base>.txt
#      —— 约定目录：任何集成方都可往里写真实标题（如 cyj-todo 写飞书任务标题）
#   2) claude/codex 的 pane_title（去掉前导 spinner 字形）
#
# 用于 tmux status-right：
#   set -g status-right ' #(~/WorkSpace/tui-agent-hud/bin/agent-hud-title) '
#   set -g status-interval 5
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/tui-agent-hud"
TITLE_DIR="$STATE_DIR/title"

# $1 仅供调试（模拟 window_name）；正常由 tmux 对当前 active window 求值
name="${1:-$(tmux display-message -p '#{window_name}' 2>/dev/null)}"
# base = 剥前导字形 + 去 ·后缀；可为 task-XXXX 或任意自定义窗名（workflow / memory…）
base=$(printf '%s' "$name" | sed -E 's/^[🟢🟡🔴][[:space:]]+//; s/·.*//; s/[[:space:]]+$//')

# 窗名为空（异常）→ pane_title 兜底
if [ -z "$base" ]; then
  tmux display-message -p '#{pane_title}' 2>/dev/null
  exit 0
fi

title=""
# 1) 标题缓存（约定目录）
[ -f "$TITLE_DIR/$base.txt" ] && title=$(cat "$TITLE_DIR/$base.txt")
# 2) 回退 pane_title 去前导 spinner
if [ -z "$title" ]; then
  pt=$(tmux display-message -p '#{pane_title}' 2>/dev/null)
  title=$(printf '%s' "$pt" | sed -E 's/^[^ ]+ //')
fi

printf '%s' "$title"
